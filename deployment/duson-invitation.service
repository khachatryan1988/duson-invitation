[Unit]
Description=DUSON Invitation Flask App
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/duson_invitation
EnvironmentFile=/var/www/duson_invitation/.env
ExecStart=/var/www/duson_invitation/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
